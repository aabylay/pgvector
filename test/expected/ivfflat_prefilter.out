 Prefilter Index: t_partial_idx
 Prefilter TIDs: 15
 Prefilter Rebuilds: 0
(5 rows)

SELECT id FROM t WHERE category = 1 AND extra = 4 ORDER BY val <-> '[0,0,0]' LIMIT 3;
 id  
-----
  11
  81
