(3 rows)

DROP INDEX t_partial_idx;
-- expression B-tree
CREATE INDEX t_expr_idx ON t (((category + 10)));
SELECT explain_prefilter($$SELECT id FROM t WHERE category + 10 = 11 ORDER BY val <-> '[0,0,0]' LIMIT 3$$);
                      explain_prefilter                      
-------------------------------------------------------------
