SET ivfflat.prefilter = on;
SET ivfflat.include_filter = off;
EXPLAIN (COSTS OFF) SELECT id FROM inc_mix WHERE category = 1 ORDER BY embedding <-> '[0,0,0,0]' LIMIT 5;
